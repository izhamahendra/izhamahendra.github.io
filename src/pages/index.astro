---
import '../styles/global.css';
import {
  siWordpress, siWebflow, siShopify, siSquarespace, siJavascript,
  siPhp, siFigma, siGoogleanalytics, siMailchimp, siGit
} from 'simple-icons';

const skills = [
  siWordpress, siWebflow, siShopify, siSquarespace, siJavascript,
  siPhp, siFigma, siGoogleanalytics, siMailchimp, siGit
];

const experience = [
  {
    period: 'May 2025 - Present',
    company: 'D&O Creative',
    location: 'Remote',
    role: 'Web Developer',
    description: 'Build responsive, accessible websites and interactive interfaces from UI/UX designs, with attention to performance, SEO, QA, and maintainable code.'
  },
  {
    period: 'Mar 2022 - Apr 2025',
    company: 'Karma Group Global',
    location: 'Bali, Indonesia',
    role: 'Web Developer',
    description: 'Developed and maintained marketing sites, campaign landing pages, member-site forms, resort content, and HTML email campaigns in a cross-functional creative team.'
  },
  {
    period: 'Jan 2020 - Present',
    company: 'Independent',
    location: 'Worldwide',
    role: 'Freelance Web Developer',
    description: 'Design and build client websites from wireframe to launch, including tailored features, digital-marketing tracking, content updates, and e-commerce.'
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Izha Mahendra - Web Developer creating high-performing, thoughtful websites." />
    <meta name="theme-color" content="#0a0a0d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Izha Mahendra - Web Developer</title>
  </head>
  <body>
    <header class="nav-wrap">
      <nav aria-label="Main navigation">
        <a class="brand" href="#top" aria-label="Izha Mahendra, home"><span class="brand-mark">I</span><span>izha.</span></a>
        <div class="nav-links">
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="#stack">Stack</a>
        </div>
        <a class="nav-cta" href="mailto:imahendra15@gmail.com">Let's talk <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="top">
      <section class="hero section-shell">
        <div class="hero-orb" aria-hidden="true"></div>
        <p class="eyebrow"><span></span> Available for selected projects</p>
        <h1>I build websites<br />people <em>want</em> to use.</h1>
        <div class="hero-foot">
          <p>Web Developer based in Bali, crafting thoughtful marketing sites, CMS experiences, and e-commerce storefronts that feel as good as they perform.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="mailto:imahendra15@gmail.com">Start a conversation <span aria-hidden="true">→</span></a>
            <a class="text-link" href="#experience">Explore my experience <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="scroll-note" aria-hidden="true"><span></span> Scroll to explore</div>
      </section>

      <section id="about" class="intro section-shell">
        <p class="section-label">01 / About</p>
        <div class="intro-copy">
          <p class="intro-lead">Five+ years turning ideas, wireframes, and brand systems into <strong>fast, responsive, conversion-minded websites.</strong></p>
          <p>I bring the practical range to take a site from visual direction through implementation and launch—whether it lives in WordPress, Webflow, Shopify, Squarespace, or custom front-end code.</p>
        </div>
        <div class="value-grid">
          <article><span>01</span><h2>Build with intent</h2><p>Clear hierarchy, responsive systems, accessible interactions, and detail that holds up on every screen.</p></article>
          <article><span>02</span><h2>Make it perform</h2><p>Performance, SEO, QA, and clean handover are part of the work—not a final checklist.</p></article>
          <article><span>03</span><h2>Ship collaboratively</h2><p>Comfortable partnering with designers, developers, and stakeholders to make complex work feel straightforward.</p></article>
        </div>
      </section>

      <section id="experience" class="experience section-shell">
        <div class="section-heading"><p class="section-label">02 / Experience</p><p>Selected roles and the work behind the interface.</p></div>
        <div class="timeline">
          {experience.map((item) => (
            <article class="role">
              <p class="role-period">{item.period}</p>
              <div><h2>{item.company}</h2><p class="role-meta">{item.role} <span>·</span> {item.location}</p></div>
              <p class="role-description">{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="work-placeholder section-shell" aria-labelledby="work-heading">
        <p class="section-label">03 / Selected work</p>
        <div class="placeholder-card">
          <div class="placeholder-grid" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <div class="placeholder-content"><p class="mono">CASE STUDIES / IN PROGRESS</p><h2 id="work-heading">The next chapter is<br /><em>being documented.</em></h2><p>Project case studies will be added here—showing the challenge, the craft, and the result behind each launch.</p></div>
          <div class="placeholder-number" aria-hidden="true">∞</div>
        </div>
      </section>

      <section id="stack" class="stack section-shell">
        <div class="section-heading"><p class="section-label">04 / Stack</p><p>A practical toolkit for modern web delivery.</p></div>
        <div class="logo-marquee" aria-label="Technologies and tools I use">
          <div class="logo-track">
            {[...skills, ...skills].map((skill, index) => (
              <div class="logo-item" aria-hidden={index >= skills.length ? 'true' : undefined}>
                <svg viewBox="0 0 24 24" role="img" aria-label={skill.title} aria-hidden={index >= skills.length ? 'true' : undefined}>
                  <path d={skill.path}></path>
                </svg>
                <span>{skill.title}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="contact section-shell">
        <p class="section-label">05 / Contact</p>
        <h2>Have an idea<br />worth building?</h2>
        <a href="mailto:imahendra15@gmail.com" class="contact-email">imahendra15@gmail.com <span aria-hidden="true">↗</span></a>
        <div class="contact-meta"><span>Denpasar, Bali, Indonesia</span><a href="https://www.linkedin.com/in/izha-mahendra/" target="_blank" rel="noreferrer">LinkedIn ↗</a></div>
      </section>
    </main>

    <footer><span>© {new Date().getFullYear()} Izha Mahendra</span><span>Designed & built with care.</span></footer>
  </body>
</html>

